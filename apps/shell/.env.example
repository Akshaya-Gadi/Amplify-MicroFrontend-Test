# Remote microfrontend entry points consumed by the shell at BUILD time.
# Local dev (vite preview of remotes):
VITE_BILLING_REMOTE_URL=http://localhost:5001/assets/remoteEntry.js
VITE_CLAIMS_REMOTE_URL=http://localhost:5002/assets/remoteEntry.js

# Production (set these in the Amplify Console -> shell-app -> Environment variables):
# VITE_BILLING_REMOTE_URL=https://billing.example.com/assets/remoteEntry.js
# VITE_CLAIMS_REMOTE_URL=https://claims.example.com/assets/remoteEntry.js
